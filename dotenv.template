# ============================================================
#  FutureSelf configuration
#  Copy this file to ".env" (Run_FutureSelf.bat does it for you)
#  and fill in the values you need.
#  Put each value right after the "=" and keep comments on their own lines.
# ============================================================

# ---- Server ----
# HOST: use 0.0.0.0 to open the app from your phone on the same Wi-Fi
HOST=127.0.0.1
PORT=5000
# PUBLIC_URL: public address once deployed, e.g. https://futureself.yourdomain.com
PUBLIC_URL=
DEFAULT_TIMEZONE=Asia/Kolkata

# ---- Security (REQUIRED for real use) ----
# Long random text used to sign logins. Run_FutureSelf.bat generates one automatically.
SECRET_KEY=change-me
TOKEN_DAYS=30

# ---- Database ----
# STORAGE=auto  : use MongoDB if MONGO_URI is set and reachable, otherwise a local file in ./data
# STORAGE=mongo : require MongoDB (stops with an error if it cannot connect)
# STORAGE=file  : always use the local file
STORAGE=auto
# MONGO_URI examples:
#   mongodb://localhost:27017
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net
MONGO_URI=
MONGO_DB=futureself
DATA_DIR=data

# ---- Phone reminders ----
# ntfy: free push to the ntfy Android app. Keep the default to use the public server.
NTFY_SERVER=https://ntfy.sh
# NTFY_TOKEN is only needed for a private ntfy server with access control.
NTFY_TOKEN=
# Telegram: create a bot with @BotFather and paste its token here.
# Each user then adds their own chat ID in Settings.
TELEGRAM_BOT_TOKEN=

# ---- Reserved for later phases (not used yet) ----
# Firebase push for the native Android app
FCM_SERVER_KEY=
FCM_SERVICE_ACCOUNT_JSON=
# Email reminders
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# AI-generated quizzes and study help
ANTHROPIC_API_KEY=
